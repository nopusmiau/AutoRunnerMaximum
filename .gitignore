# Unity .gitignore (base: github/gitignore Unity.gitignore + extras)
# Colocar en la RAIZ del proyecto Unity (donde estan Assets/, Packages/, ProjectSettings/)

# ---------------------------------------------------------------
# Carpetas generadas por Unity
# ---------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender: los .blend1 son backups automaticos
*.blend1
*.blend1.meta

# MemoryCaptures pueden ser enormes y contener datos sensibles
/[Mm]emoryCaptures/

# Recordings pueden ser enormes
/[Rr]ecordings/

# Descomenta si quieres ignorar el plugin Asset Store Tools
# /[Aa]ssets/AssetStoreTools*

# ---------------------------------------------------------------
# IDEs y editores
# ---------------------------------------------------------------
# Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.idea/

# Visual Studio / VS Code
.vs/
.vscode/

# Gradle
.gradle/

# Archivos de solucion/proyecto autogenerados
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Meta de archivos generados
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Mono
mono_crash.*

# ---------------------------------------------------------------
# Builds
# ---------------------------------------------------------------
*.apk
*.aab
*.ipa
*.exe
*.dmg
*.app
*.unitypackage
*.unitypackage.meta

# Crashlytics
crashlytics-build.properties

# ---------------------------------------------------------------
# SECRETOS (Android signing, nunca subir)
# ---------------------------------------------------------------
*.keystore
*.jks

# ---------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# Archivos autogenerados por paquetes de Unity
# ---------------------------------------------------------------
# TestRunner
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# UI Toolkit
/UIElementsSchema/

# Cache de dependencias de escena
/[Aa]ssets/[Ss]ceneDependencyCache*